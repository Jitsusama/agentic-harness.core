{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023"],
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"noEmit": true
	},
	"include": [
		"tdd",
		"shell",
		"command",
		"git-cli",
		"github-cli",
		"attribution",
		"verify",
		"memory",
		"internal",
		"quest",
		"refs",
		"prose",
		"ui",
		"terminal",
		"tree",
		"lsp",
		"result",
		"gate",
		"sections",
		"title",
		"guardian",
		"clock",
		"thinking",
		"exec",
		"remote",
		"process",
		"work",
		"review",
		"web",
		"bin",
		"tests"
	]
}
