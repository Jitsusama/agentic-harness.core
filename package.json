{
	"name": "@jitsusama/agentic-harness.core",
	"version": "0.1.0",
	"description": "Pi-agnostic business logic for agentic-harness: state machines, guardian decisions, quest/TDD domain model.",
	"license": "MIT",
	"type": "module",
	"exports": {
